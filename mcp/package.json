{
  "name": "@teach-me/runtime-adapter",
  "version": "1.0.0-beta.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild src/adapter.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/adapter.js",
    "check": "npm run typecheck && npm run test",
    "test": "npm run build --silent && node --test test/adapter.test.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
