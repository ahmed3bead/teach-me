{
  "name": "@teach-me/runtime-adapter",
  "version": "1.0.0-beta.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:adapter --silent && npm run build:worker --silent",
    "build:adapter": "esbuild src/adapter.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/adapter.js --log-level=warning",
    "build:worker": "esbuild src/worker.ts --bundle --format=esm --platform=neutral --target=es2022 --main-fields=module,main --conditions=workerd,worker,browser --outfile=dist/worker.js --log-level=warning",
    "build:production": "wrangler deploy --dry-run --outdir dist/production",
    "check": "npm run typecheck && npm run test",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 8787",
    "test": "npm run build --silent && node --test --test-timeout=30000 test/adapter.test.mjs test/worker.test.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260926.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "wrangler": "4.141.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5"
  }
}
