{
  "schema_version": "1.0.0",
  "manifest_version": "1.0.0",
  "teach_me_version": "1.0.0-beta.2",
  "selection_model": "explicit-allowlist",
  "ordering": {
    "key": "order",
    "direction": "ascending",
    "require_contiguous": true
  },
  "module_categories": [
    {"id": "topic-led-conversational", "status": "active"},
    {"id": "educator-guidance", "status": "active"},
    {"id": "child-guidance", "status": "active"},
    {"id": "source-grounded", "status": "active"},
    {"id": "domain-packs", "status": "reserved"},
    {"id": "accessibility", "status": "reserved"},
    {"id": "safety", "status": "reserved"},
    {"id": "artifact-guidance", "status": "reserved"}
  ],
  "asset_classifications": [
    "entrypoint",
    "policy",
    "engine",
    "continuity",
    "locale"
  ],
  "canonical_roots": [
    {"path": "SKILL.md", "kind": "file"},
    {"path": "references", "kind": "directory"},
    {"path": "domain-packs", "kind": "directory"},
    {"path": "templates", "kind": "directory"},
    {"path": "schemas", "kind": "directory"}
  ],
  "allowed_suffixes": [".md", ".json", ".yaml", ".html"],
  "prohibited": {
    "path_prefixes": [
      ".git",
      ".agents",
      ".claude-plugin",
      ".github",
      ".venv",
      "agents",
      "chatgpt-edition",
      "claude-edition",
      "dist",
      "docs",
      "evals",
      "fixtures",
      "installers",
      "mcp",
      "node_modules",
      "plugins",
      "reports",
      "scripts",
      "skills",
      "venv"
    ],
    "path_segments": [
      ".git",
      ".venv",
      "__pycache__",
      "node_modules",
      "reports"
    ],
    "basenames": [
      ".env",
      ".env.local",
      ".env.production",
      ".env.test"
    ],
    "suffixes": [
      ".bak",
      ".log",
      ".pyc",
      ".pyo",
      ".swp",
      ".tmp"
    ]
  },
  "limits": {
    "max_asset_count": 64,
    "max_individual_asset_bytes": 131072,
    "max_total_asset_bytes": 524288
  },
  "assets": [
    {
      "order": 1,
      "id": "chatgpt-runtime-core",
      "path": "references/chatgpt-runtime-core.md",
      "classification": "entrypoint",
      "required": true,
      "module_categories": ["topic-led-conversational"]
    },
    {
      "order": 2,
      "id": "chatgpt-runtime-educator",
      "path": "references/chatgpt-runtime-educator.md",
      "classification": "policy",
      "required": true,
      "module_categories": ["educator-guidance"]
    },
    {
      "order": 3,
      "id": "chatgpt-runtime-child",
      "path": "references/chatgpt-runtime-child.md",
      "classification": "policy",
      "required": true,
      "module_categories": ["child-guidance"]
    },
    {
      "order": 4,
      "id": "chatgpt-runtime-source",
      "path": "references/chatgpt-runtime-source.md",
      "classification": "policy",
      "required": true,
      "module_categories": ["source-grounded"]
    },
    {
      "order": 5,
      "id": "chatgpt-runtime-video",
      "path": "references/chatgpt-runtime-video.md",
      "classification": "engine",
      "required": true,
      "module_categories": ["source-grounded"]
    },
    {
      "order": 6,
      "id": "chatgpt-runtime-curriculum",
      "path": "references/chatgpt-runtime-curriculum.md",
      "classification": "engine",
      "required": true,
      "module_categories": ["source-grounded"]
    }
  ]
}
