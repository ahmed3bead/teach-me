      "fixtures",
      "installers",
      "mcp",
      "node_modules",
      "plugins",
      "reports",
      "scripts",
      "skills",
      "venv"
    ],
    "path_segments": [
      ".git",
      ".venv",
      "__pycache__",
      "node_modules",
      "reports"
    ],
    "basenames": [
      ".env",
      ".env.local",
      ".env.production",
      ".env.test"
    ],
    "suffixes": [
      ".bak",
      ".log",
      ".pyc",
      ".pyo",
      ".swp",
      ".tmp"
    ]
  },
  "limits": {
    "max_asset_count": 64,
    "max_individual_asset_bytes": 131072,
    "max_total_asset_bytes": 524288
