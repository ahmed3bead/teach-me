{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "teach-me-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  // Stateless, read-only service: no KV, D1, R2, Durable Objects, queues, or other bindings.
  // Request logging stays off so no learner-adjacent metadata is retained.
  "observability": { "enabled": false }
}
