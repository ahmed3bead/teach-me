{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmed3bead/teach-me/schemas/source-coverage.schema.json",
  "title": "Teach Me source coverage ledger",
  "type": "object",
  "required": ["version", "session_id", "sources", "overall_status"],
  "properties": {
    "version": {"const": "1.0.0"},
    "session_id": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "title", "media_type", "access", "inspected_components", "coverage", "confidence", "limitations"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "location": {"type": "string"},
          "media_type": {"enum": ["text", "document", "audio", "video", "playlist", "course", "website", "mixed"]},
          "access": {"enum": ["full", "partial", "metadata-only", "unavailable"]},
          "inspected_components": {"type": "array", "items": {"enum": ["text", "structure", "audio", "transcript-human", "transcript-auto", "visuals", "frames-sampled", "frames-complete", "ocr", "links", "attachments", "metadata"]}, "uniqueItems": true},
          "coverage": {"enum": ["complete", "progressive", "sampled", "metadata-only", "none"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "source_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "overall_status": {"enum": ["ready-to-teach", "ready-for-progressive-study", "needs-more-access", "independent-alternative-only"]}
  },
  "additionalProperties": false
}
