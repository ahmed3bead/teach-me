{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmed3bead/teach-me/schemas/curriculum-map.schema.json",
  "title": "Teach Me curriculum map",
  "type": "object",
  "required": ["version", "session_id", "curriculum_id", "audience", "sources", "units", "approval_status"],
  "properties": {
    "version": {"const": "1.0.0"},
    "session_id": {"type": "string", "minLength": 1},
    "curriculum_id": {"type": "string", "minLength": 1},
    "audience": {
      "type": "object",
      "required": ["age_band", "language"],
      "properties": {
        "age_band": {"type": "string", "minLength": 1},
        "language": {"description": "Canonical values are ar-MSA and en; ar-EG is a read-compatibility alias.", "enum": ["ar-MSA", "ar-EG", "en"]},
        "context": {"type": "string"}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "title"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "location": {"type": "string"},
          "usage_authorized": {"type": ["boolean", "null"]}
        },
        "additionalProperties": false
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "title", "objective_ids", "outcomes", "origin"],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "objective_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "prerequisites": {"type": "array", "items": {"type": "string"}},
          "origin": {"enum": ["curriculum", "educator", "inferred", "external", "adaptation"]},
          "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "flags": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "approval_status": {"enum": ["draft", "educator-approved", "revision-requested"]}
  },
  "additionalProperties": false
}
