{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmed3bead/teach-me/schemas/feedback.schema.json",
  "title": "Teach Me minimized feedback event",
  "type": "object",
  "required": ["version", "event_id", "recorded_at", "skill_version", "consent", "audience", "input_mode", "locale", "subject_category", "failure_category", "outcome", "reproducible_summary", "contains_personal_data"],
  "properties": {
    "version": {"const": "1.0.0"},
    "event_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "skill_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "consent": {"const": true},
    "audience": {"enum": ["learner", "educator"]},
    "input_mode": {"enum": ["topic-led", "source-grounded"]},
    "locale": {"description": "Canonical values are ar-MSA and en; ar-EG is a read-compatibility alias.", "enum": ["ar-MSA", "ar-EG", "en"]},
    "subject_category": {"type": "string", "minLength": 1},
    "host": {"type": "string", "minLength": 1},
    "model_family": {"type": "string", "minLength": 1},
    "failure_category": {"enum": ["none", "knowledge-error", "missing-context", "bad-source", "level-mismatch", "teaching-failure", "assessment-failure", "language-failure", "memory-failure", "unsafe-advice", "tool-failure"]},
    "outcome": {"enum": ["helped", "partly-helped", "did-not-help", "not-assessed"]},
    "reproducible_summary": {"type": "string", "maxLength": 1000},
    "contains_personal_data": {"type": "boolean"}
  },
  "additionalProperties": false
}
