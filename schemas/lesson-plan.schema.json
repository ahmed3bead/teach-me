{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmed3bead/teach-me/schemas/lesson-plan.schema.json",
  "title": "Teach Me educator lesson plan",
  "type": "object",
  "required": ["version", "session_id", "lesson_id", "title", "objective_ids", "duration_minutes", "outcomes", "sequence", "assessment", "traceability"],
  "properties": {
    "version": {"const": "1.0.0"},
    "session_id": {"type": "string", "minLength": 1},
    "lesson_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "duration_minutes": {"type": "integer", "minimum": 1},
    "objective_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prerequisite_check": {"type": "array", "items": {"type": "string"}},
    "materials": {"type": "array", "items": {"type": "string"}},
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["minutes", "teacher_action", "learner_action"],
        "properties": {
          "minutes": {"type": "integer", "minimum": 1},
          "teacher_action": {"type": "string", "minLength": 1},
          "learner_action": {"type": "string", "minLength": 1},
          "check_for_understanding": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "differentiation": {
      "type": "object",
      "properties": {
        "support": {"type": "array", "items": {"type": "string"}},
        "core": {"type": "array", "items": {"type": "string"}},
        "extension": {"type": "array", "items": {"type": "string"}},
        "accessibility": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": ["assessment_id", "objective_ids", "task", "success_evidence"],
      "properties": {
        "assessment_id": {"type": "string", "minLength": 1},
        "objective_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "task": {"type": "string", "minLength": 1},
        "success_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "answer_key_or_rubric": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lesson_element", "origin"],
        "properties": {
          "lesson_element": {"type": "string", "minLength": 1},
          "origin": {"enum": ["curriculum", "educator", "inferred", "external", "adaptation"]},
          "source_ref": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
