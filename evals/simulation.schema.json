{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmed3bead/teach-me/evals/simulation.schema.json",
  "title": "Teach Me dynamic learner simulation suite",
  "type": "object",
  "required": ["suite", "version", "simulations"],
  "properties": {
    "suite": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"const": "1.0.0"},
    "simulations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "locale", "critical", "max_turns", "learner_persona", "learner_behaviors", "initial_request", "teaching_material", "baseline_task", "transfer_task", "expected", "minimum_gain", "minimum_transfer"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "locale": {"description": "Use ar-MSA or en; ar-EG is a deprecated alias normalized to ar-MSA.", "enum": ["ar-MSA", "ar-EG", "en"]},
          "critical": {"type": "boolean"},
          "max_turns": {"type": "integer", "minimum": 2, "maximum": 12},
          "learner_persona": {"type": "string", "minLength": 1},
          "learner_behaviors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {
                  "type": "object",
                  "required": ["instruction", "expected_assessment_intent"],
                  "properties": {
                    "instruction": {"type": "string", "minLength": 1},
                    "expected_assessment_intent": {"enum": ["none", "accept", "decline"]}
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "initial_request": {"type": "string", "minLength": 1},
          "teaching_material": {"type": "string", "minLength": 1},
          "baseline_task": {"type": "string", "minLength": 1},
          "transfer_task": {"type": "string", "minLength": 1},
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["evidence_scope", "criterion"],
              "properties": {
                "evidence_scope": {"enum": ["baseline", "transcript", "transfer"]},
                "criterion": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "minimum_gain": {"type": "number", "minimum": 0, "maximum": 1},
          "minimum_transfer": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
