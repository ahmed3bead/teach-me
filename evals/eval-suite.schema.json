{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmed3bead/teach-me/evals/eval-suite.schema.json",
  "title": "Teach Me behavioral evaluation suite",
  "type": "object",
  "required": ["suite", "version", "cases"],
  "properties": {
    "suite": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"const": "1.0.0"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "locale", "routing", "capabilities", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "locale": {"enum": ["ar-MSA", "en"]},
        "routing": {
          "type": "object",
          "required": ["audience", "mode", "source_type", "artifact_type", "session_state", "accessibility", "safety_level", "instructional_scope", "assessment_state", "domain_pack"],
          "properties": {
            "audience": {"enum": ["learner", "educator"]}, "mode": {"enum": ["topic-led", "source-grounded"]},
            "source_type": {"enum": ["none", "book", "document", "video", "playlist", "course", "curriculum", "website"]},
            "artifact_type": {"enum": ["chat", "markdown", "html", "pdf", "curriculum", "learning-pack"]},
            "session_state": {"enum": ["new", "resume", "multi-turn"]},
            "accessibility": {"enum": ["standard", "child", "screen-reader", "audio", "blocked"]},
            "safety_level": {"enum": ["standard", "sensitive", "high-stakes"]},
            "instructional_scope": {"enum": ["brief", "substantial", "journey"]},
            "assessment_state": {"enum": ["none", "offered", "accepted", "declined", "intensive"]},
            "domain_pack": {"enum": ["none", "photography", "programming"]}
          }, "additionalProperties": false
        },
        "capabilities": {
          "type": "object", "required": ["source", "web", "file", "rendering", "sandbox", "video", "external_catalog"],
          "properties": {
            "source": {"$ref": "#/$defs/capabilityState"}, "web": {"$ref": "#/$defs/capabilityState"},
            "file": {"$ref": "#/$defs/capabilityState"}, "rendering": {"$ref": "#/$defs/capabilityState"},
            "sandbox": {"$ref": "#/$defs/capabilityState"}, "video": {"$ref": "#/$defs/capabilityState"},
            "external_catalog": {"$ref": "#/$defs/capabilityState"}
          }, "additionalProperties": false
        },
        "fixture_refs": {
          "type": "object",
          "propertyNames": {"enum": ["source", "web", "file", "rendering", "sandbox", "video", "external_catalog", "context"]},
          "additionalProperties": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"}
        },
        "critical": {"type": "boolean"}, "prompt": {"type": "string", "minLength": 1},
        "turns": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/turn"}},
        "expected": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "oneOf": [{"required": ["prompt"], "not": {"required": ["turns"]}}, {"required": ["turns"], "not": {"required": ["prompt"]}}],
      "additionalProperties": false
    },
    "capabilityState": {"enum": ["unavailable", "not_required", "supplied_result", "executable_temp"]},
    "turn": {
      "type": "object", "required": ["role", "content"],
      "properties": {
        "role": {"const": "user"}, "content": {"type": "string", "minLength": 1},
        "assessment_intent": {"enum": ["none", "accept", "decline"]},
        "assessment_boundary": {"enum": ["continue", "complete", "new-unit"]}
      }, "additionalProperties": false
    }
  }
}
