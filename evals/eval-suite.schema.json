{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmed3bead/teach-me/evals/eval-suite.schema.json",
  "title": "Teach Me behavioral evaluation suite",
  "type": "object",
  "required": ["suite", "version", "cases"],
  "properties": {
    "suite": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"const": "1.0.0"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "locale": {"description": "Use ar-MSA or en; ar-EG is a deprecated alias normalized to ar-MSA.", "enum": ["ar-MSA", "ar-EG", "en"]},
          "critical": {"type": "boolean"},
          "prompt": {"type": "string", "minLength": 1},
          "turns": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["role", "content"],
              "properties": {
                "role": {"const": "user"},
                "content": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "oneOf": [
          {"required": ["prompt"], "not": {"required": ["turns"]}},
          {"required": ["turns"], "not": {"required": ["prompt"]}}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
